/.phpunit.cache
/.phpunit.result.cache
/.DS_Store
/.env
/.env.*
!/.env.example
/auth.json
/composer.phar
/node_modules
/vendor
/npm-debug.log
/yarn-error.log

# Local databases and exports must not be committed.
/database/*.sqlite
/database/*.sqlite-*
*.sql
*.sql.gz

# Runtime files and CMS uploads are deployed separately from application source.
/public/storage
/storage/*.key
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*.php

# The application serves Constra assets from public/web; this is the unused
# original template reference directory retained locally.
/web/

# IDE and OS workspace files.
/.idea
/.vscode
/.fleet
